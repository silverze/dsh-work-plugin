# Feishu self-built app (developer console -> Credentials & Basic Info)
FEISHU_APP_ID=cli_your_app_id
# Dev only. Production stores this in the DSH credentials store, never in .env.
FEISHU_APP_SECRET=your_app_secret

# Must exactly match a redirect URL configured on the Feishu app.
# The loopback port is fixed so the URL can be whitelisted once.
FEISHU_REDIRECT_URI=http://127.0.0.1:17321/feishu/oauth/callback

# Space-separated scopes requested at authorization time.
FEISHU_SCOPES="docx:document sheets:spreadsheet drive:drive wiki:wiki im:message im:message:send_as_bot contact:user.base:readonly offline_access"

# Optional: default model and artifact root for local development.
DSH_WORK_DEFAULT_MODEL=
DSH_WORK_ARTIFACT_ROOT=

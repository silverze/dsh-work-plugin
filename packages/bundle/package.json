{
  "name": "@dsh-work-plugin/bundle",
  "version": "0.1.1",
  "description": "DSH Work bundle: composes the work profile with task services, Feishu tools, the workbench client panel, and bundled work skills.",
  "license": "MIT",
  "author": "silverze",
  "homepage": "https://github.com/silverze/dsh-work-plugin#readme",
  "bugs": {
    "url": "https://github.com/silverze/dsh-work-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverze/dsh-work-plugin.git",
    "directory": "packages/bundle"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "work",
    "workbench",
    "feishu"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "presets",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/work.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@dsh-work-plugin/client": "workspace:^",
    "@dsh-work-plugin/host": "workspace:^",
    "@dsh-work-plugin/feishu": "workspace:^",
    "@dsh-work-plugin/skills": "workspace:^"
  }
}

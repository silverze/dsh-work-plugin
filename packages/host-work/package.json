{
  "name": "@dsh-work-plugin/host",
  "version": "0.1.2",
  "description": "DSH Work host services: work tasks, artifact library, schedule binding, and notifications.",
  "license": "MIT",
  "author": "silverze",
  "homepage": "https://github.com/silverze/dsh-work-plugin#readme",
  "bugs": {
    "url": "https://github.com/silverze/dsh-work-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverze/dsh-work-plugin.git",
    "directory": "packages/host-work"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "work-task",
    "scheduler"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "native",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.2 <0.2.3-0 || >=0.2.3-0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.2 <0.2.3-0 || >=0.2.3-0 <0.3.0",
    "@deepseek-ai/dsh-schedule": ">=0.2.2-rc.2 <0.2.3-0 || >=0.2.3-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.2 <0.2.3-0 || >=0.2.3-0 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.2 <0.2.3-0 || >=0.2.3-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2 <0.2.3-0 || >=0.2.3-0 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.2 <0.2.3-0 || >=0.2.3-0 <0.3.0"
  },
  "dependencies": {
    "zod": "4.6.6",
    "tar": "^7.5.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-schedule": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2"
  }
}
